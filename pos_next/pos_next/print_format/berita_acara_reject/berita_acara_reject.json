 "html": "<style>\n\t.ba-wrapper {\n\t\tfont-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n\t\tfont-size: 11pt;\n\t\tline-height: 1.5;\n\t\tcolor: #000;\n\t}\n\t.ba-title {\n\t\ttext-align: center;\n\t\tfont-size: 12pt;\n\t\tfont-weight: bold;\n\t\tmargin: 20px 0 15px 0;\n\t}\n\t.ba-info-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 12px;\n\t}\n\t.ba-info-table td {\n\t\tpadding: 2px 0;\n\t\tvertical-align: top;\n\t}\n\t.ba-items-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin: 15px 0;\n\t}\n\t.ba-items-table th, .ba-items-table td {\n\t\tborder: 1px solid #000;\n\t\tpadding: 6px 8px;\n\t\tfont-size: 10pt;\n\t}\n\t.ba-items-table th {\n\t\ttext-align: center;\n\t\tfont-weight: bold;\n\t\tbackground-color: #f8f8f8;\n\t}\n\t.ba-sign-table {\n\t\twidth: 100%;\n\t\tmargin-top: 30px;\n\t\tborder-collapse: collapse;\n\t}\n\t.ba-sign-table td {\n\t\twidth: 33.33%;\n\t\ttext-align: center;\n\t\tvertical-align: top;\n\t\tpadding: 5px;\n\t}\n\t.ba-sign-space {\n\t\theight: 60px;\n\t}\n</style>\n\n{% if letter_head and not no_letterhead %}\n<div class=\"letter-head\" style=\"margin-bottom: 15px;\">{{ letter_head }}</div>\n{% endif %}\n\n<div class=\"ba-wrapper\">\n\t<div class=\"ba-title\">BERITA ACARA ROTI / BAHAN / BARANG RUSAK (REJECT)</div>\n\n\t<p style=\"margin-bottom: 10px;\">\n\t\tPada hari ini, {{ frappe.utils.format_date(doc.incident_date, 'EEEE, d MMMM yyyy') }} kami yang bertanda tangan di bawah ini:\n\t</p>\n\n\t{% set owner_name = frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner %}\n\t{% set approver_name = frappe.db.get_value(\"User\", doc.decided_by, \"full_name\") or doc.decided_by or '-' %}\n\t<table class=\"ba-info-table\">\n\t\t<tr>\n\t\t\t<td style=\"width: 80px;\">Nama</td>\n\t\t\t<td style=\"width: 15px;\">:</td>\n\t\t\t<td>{{ owner_name }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Jabatan</td>\n\t\t\t<td>:</td>\n\t\t\t<td>Outlet</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Outlet</td>\n\t\t\t<td>:</td>\n\t\t\t<td>{{ doc.pos_profile or '-' }}</td>\n\t\t</tr>\n\t</table>\n\n\t<p style=\"margin: 12px 0;\">\n\t\tDengan ini menyatakan bahwa sejumlah Barang / Produk dinyatakan <strong>TIDAK LAYAK JUAL / TIDAK LAYAK DIGUNAKAN</strong> dan harus di <strong>Reject / dimusnahkan</strong>.\n\t</p>\n\n\t<p style=\"margin-bottom: 6px;\">Rincian barang reject :</p>\n\n\t<table class=\"ba-items-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width: 40px; text-align: center;\">NO</th>\n\t\t\t\t<th style=\"text-align: left;\">Nama Produk</th>\n\t\t\t\t<th style=\"width: 120px; text-align: center;\">Jumlah (Pcs/Gr)</th>\n\t\t\t\t<th style=\"width: 130px; text-align: center;\">Tanggal Produksi</th>\n\t\t\t\t<th style=\"width: 180px; text-align: left;\">Alasan Reject</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for item in doc.items %}\n\t\t\t<tr>\n\t\t\t\t<td style=\"text-align: center;\">{{ loop.index }}</td>\n\t\t\t\t<td>{{ item.item_name or item.item_code }}</td>\n\t\t\t\t<td style=\"text-align: center;\">{{ '%g' % (item.qty or 0) }} {{ item.uom or '' }}</td>\n\t\t\t\t<td style=\"text-align: center;\">\n\t\t\t\t\t{% if item.production_date %}\n\t\t\t\t\t\t{{ frappe.utils.format_date(item.production_date, 'd MMMM yyyy') }}\n\t\t\t\t\t{% else %}\n\t\t\t\t\t\t-\n\t\t\t\t\t{% endif %}\n\t\t\t\t</td>\n\t\t\t\t<td>{{ item.reject_reason or doc.reason or '-' }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t\t</table>\n\n\t<table class=\"ba-sign-table\">\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t<strong>Dibuat Oleh</strong><br>\n\t\t\t\t<span>Karyawan / Crew</span>\n\t\t\t\t<div class=\"ba-sign-space\"></div>\n\t\t\t\t<u>{{ owner_name }}</u>\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t\t<strong>Diketahui Oleh</strong><br>\n\t\t\t\t<span>PIC / PL Outlet</span>\n\t\t\t\t<div class=\"ba-sign-space\"></div>\n\t\t\t\t<u>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u>\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t\t<strong>Kode Persetujuan</strong><br>\n\t\t\t\t<span>Operasional Outlet</span>\n\t\t\t\t<div class=\"ba-sign-space\" style=\"height: 35px; padding-top: 15px; font-weight: bold; font-size: 13pt; letter-spacing: 2px;\">\n\t\t\t\t\t{{ doc.approval_code or '-' }}\n\t\t\t\t</div>\n\t\t\t\t<u>{{ approver_name }}</u><br>\n\t\t\t\t<small>{{ frappe.utils.format_date(doc.decided_on, 'd MMMM yyyy') if doc.decided_on else '-' }}</small>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</div>\n",
