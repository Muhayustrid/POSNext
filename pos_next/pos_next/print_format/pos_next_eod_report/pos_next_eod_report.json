 "doctype": "Print Format",
 "font_size": 11,
 "html": "<style>\n\t/* Everything starts normal: the bitmap renderer's baseline CSS bolds the\n\t   whole frame, so the title, the group headers and the two total rows are\n\t   the only rules that re-bold. */\n\t* { font-weight: normal; }\n\tbody {\n\t\tfont-family: 'DejaVu Sans', 'Arial', sans-serif;\n\t\tcolor: #111827;\n\t\tpadding: 8px;\n\t\tfont-size: 11px;\n\t\tline-height: 1.3;\n\t}\n\t/* Group rules: a group breathes above and hugs the header it introduces,\n\t   the same asymmetric spacing the receipt's separators use. */\n\t.group { border-top: 2px dashed #000; margin-top: 10px; padding-top: 6px; }\n\t.group-title {\n\t\tfont-size: 10px;\n\t\tfont-weight: bold;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.5px;\n\t\tmargin-bottom: 3px;\n\t}\n\t.recap-title {\n\t\tfont-size: 16px;\n\t\tfont-weight: bold;\n\t\tletter-spacing: 1px;\n\t\ttext-align: center;\n\t}\n\t.company { text-align: center; margin-top: 2px; }\n\t/* The info block is the one framed group \u2014 dashed, like the separators. */\n\t.info-frame { border: 2px dashed #000; margin-top: 10px; padding: 6px; }\n\t.row { display: flex; justify-content: space-between; gap: 8px; margin: 2px 0; }\n\t.value { text-align: right; }\n\t.bold { font-weight: bold; }\n\t.cat-head { margin-top: 5px; }\n\t.leader { flex: 1; border-bottom: 1px dotted #9ca3af; margin-bottom: 2px; }\n\t.cat-total { border-top: 1px dotted #9ca3af; padding-top: 2px; }\n\t.muted { color: #6b7280; }\n\t.footer {\n\t\tborder-top: 2px dashed #000;\n\t\tmargin-top: 12px;\n\t\tpadding-top: 8px;\n\t\ttext-align: center;\n\t\tfont-size: 9px;\n\t}\n</style>\n\n{%- set r = get_sales_recap(doc) -%}\n{%- set dt_fmt = '%d/%m/%Y %H:%M' -%}\n{%- set start_txt = frappe.utils.get_datetime(doc.period_start_date).strftime(dt_fmt) if doc.period_start_date else '-' -%}\n{%- set close_txt = frappe.utils.get_datetime(doc.period_end_date).strftime(dt_fmt) if doc.period_end_date else '-' -%}\n{%- set print_txt = frappe.utils.now_datetime().strftime(dt_fmt) -%}\n<div class=\"recap-title\">SALES RECAP</div>\n<div class=\"company\">{{ doc.company or '' }}</div>\n\n<div class=\"info-frame\">\n\t<div class=\"row\"><span class=\"label\">Cashier</span><span class=\"value\">{{ doc.user or '-' }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Shift</span><span class=\"value\">{{ doc.name or '-' }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Start</span><span class=\"value\">{{ start_txt }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Closing</span><span class=\"value\">{{ close_txt }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Print Date</span><span class=\"value\">{{ print_txt }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Sales Summary</div>\n\t<div class=\"row\"><span class=\"label\">Total Sales</span><span class=\"value\">{{ format_rupiah(r.total_sales or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Total Order</span><span class=\"value\">{{ r.total_order or 0 }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Average per Order</span><span class=\"value\">{{ format_rupiah(r.average_per_order or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Cash Summary</div>\n\t<div class=\"row\"><span class=\"label\">Opening Balance</span><span class=\"value\">{{ format_rupiah(r.cash.opening_balance or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Cash Payment</span><span class=\"value\">{{ format_rupiah(r.cash.cash_payment or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Total Expense</span><span class=\"value\">{{ format_rupiah(r.cash.total_expense or 0) }}</span></div>\n\t<div class=\"row bold\"><span class=\"label\">Cash in Hand</span><span class=\"value\">{{ format_rupiah(r.cash.cash_in_hand or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Payment Method</div>\n\t{%- for pm in r.payment_methods -%}\n\t<div class=\"row\"><span class=\"label\">{{ pm.mode_of_payment }}</span><span class=\"value\">{{ format_rupiah(pm.amount or 0) }}</span></div>\n\t{%- endfor -%}\n\t<div class=\"row\"><span class=\"label\">Total Cash</span><span class=\"value\">{{ format_rupiah(r.total_cash or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Total Non Cash</span><span class=\"value\">{{ format_rupiah(r.total_non_cash or 0) }}</span></div>\n\t<div class=\"row bold\"><span class=\"label\">Grand Total</span><span class=\"value\">{{ format_rupiah(r.methods_grand_total or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Charge</div>\n\t<div class=\"row\"><span class=\"label\">Service Charge</span><span class=\"value\">{{ format_rupiah(r.service_charge or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Tax / PPN</span><span class=\"value\">{{ format_rupiah(r.tax_total or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Discount</div>\n\t<div class=\"row\"><span class=\"label\">Product Discount</span><span class=\"value\">{{ format_rupiah(r.product_discount or 0) }}</span></div>\n\t<div class=\"row\"><span class=\"label\">Payment Discount</span><span class=\"value\">{{ format_rupiah(r.payment_discount or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Refund</div>\n\t<div class=\"row\"><span class=\"label\">Total Refund</span><span class=\"value\">{{ format_rupiah(r.refund_total or 0) }}</span></div>\n</div>\n\n<div class=\"group\">\n\t<div class=\"group-title\">Sales per Category</div>\n\t{%- if r.categories -%}\n\t\t{%- for cat in r.categories -%}\n\t\t<div class=\"cat-head\">{{ cat.category }}</div>\n\t\t\t{%- for item in cat['items'] -%}\n\t\t<div class=\"row\"><span class=\"label\">{{ '%g' | format(item.qty or 0) }} x {{ item.item_name }}</span><span class=\"leader\"></span><span class=\"value\">{{ format_rupiah(item.amount or 0) }}</span></div>\n\t\t\t{%- endfor -%}\n\t\t<div class=\"row cat-total\"><span class=\"label\">Total {{ cat.category }}</span><span class=\"value\">{{ format_rupiah(cat.total or 0) }}</span></div>\n\t\t{%- endfor -%}\n\t{%- else -%}\n\t<div class=\"muted\">-</div>\n\t{%- endif -%}\n</div>\n\n<div class=\"footer\">\n\t<div>Thank you</div>\n</div>\n",
 "line_breaks": 0,
